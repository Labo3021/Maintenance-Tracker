# Copy this file to .env and fill in values. Never commit .env.

# --- AI model (pick one provider) ---
# "ollama" for local inference, "google" for Google AI Studio
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
# Set to the exact Gemma 4 tag you pulled (check with `ollama list`)
GEMMA_MODEL=

# Google AI Studio (cloud)
GOOGLE_API_KEY=

# --- Backend ---
BACKEND_PORT=8000
DATA_DIR=../data

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
